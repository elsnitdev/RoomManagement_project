{
  "info": {
    "name": "RoomManagement - Property & Room CRUD",
    "description": "Import vào Postman và chạy thư mục CRUD flow theo thứ tự. Chạy API bằng launch profile http trên http://localhost:5185, cấu hình ConnectionStrings__RoomManagement và migration trước. DevelopmentLandlord tự gán chủ trọ; không gửi OwnerUserId. DELETE trả 204 không có JSON body. Lỗi trả application/problem+json. Nếu dữ liệu phụ thuộc đã được tạo thêm, DELETE trả 409.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "CRUD flow",
      "item": [
        {
          "name": "01 - Create property",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/properties",
            "description": "Expected HTTP 201.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Khu mẫu Postman\",\n  \"address\": \"123 Đường Mẫu, TP.HCM\",\n  \"description\": \"Dữ liệu thử API\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { pm.collectionVariables.set(\"propertyId\", pm.response.json().data.id); }"
                ]
              }
            }
          ],
          "response": []
        },
        {
