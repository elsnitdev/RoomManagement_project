{
  "info": {
    "name": "RoomManagement API",
    "description": "Các API backend hiện có. Chọn environment RoomManagement Local, cấu hình mật khẩu rồi chạy từng request theo thứ tự phù hợp. Request tạo/duyệt/từ chối sẽ ghi dữ liệu thật vào database đang cấu hình.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5185", "type": "string" }
  ],
  "item": [
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Admin login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"userNameOrEmail\": \"{{adminUserNameOrEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200 và có accessToken', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().accessToken).to.be.a('string').and.not.empty; });", "if (pm.response.code === 200) pm.environment.set('adminToken', pm.response.json().accessToken);"] } }]
        },
        {
          "name": "Register landlord",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/register-landlord",
            "body": { "mode": "raw", "raw": "{\n  \"userName\": \"landlord_demo_001\",\n  \"email\": \"landlord_demo_001@example.com\",\n  \"password\": \"ChangeMe123!\",\n  \"confirmPassword\": \"ChangeMe123!\",\n  \"fullName\": \"Nguyen Van A\",\n  \"phoneNumber\": \"0912345678\",\n  \"citizenId\": \"012345678901\",\n  \"dateOfBirth\": \"1990-01-01\",\n  \"address\": \"Ho Chi Minh City\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 201, Pending và inactive', function () { pm.response.to.have.status(201); const d = pm.response.json().data; pm.expect(d.approvalStatus).to.eql('Pending'); pm.expect(d.isActive).to.eql(false); });", "if (pm.response.code === 201) { const d = pm.response.json().data; pm.environment.set('pendingLandlordId', d.id); pm.environment.set('userNameOrEmail', d.email); }"] } }]
        },
        {
          "name": "User login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"userNameOrEmail\": \"{{userNameOrEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200 và có accessToken', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().accessToken).to.be.a('string').and.not.empty; });", "if (pm.response.code === 200) { const r = pm.response.json(); pm.environment.set('accessToken', r.accessToken); pm.environment.set('userId', r.user.id); }"] } }]
        },
        {
          "name": "Login sai mật khẩu (401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"userNameOrEmail\": \"{{adminUserNameOrEmail}}\",\n  \"password\": \"invalid-password\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 401', function () { pm.response.to.have.status(401); });"] } }]
        },
        {
          "name": "Register chung chưa triển khai (501)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"userName\": \"sample_user\",\n  \"email\": \"sample@example.com\",\n  \"password\": \"ChangeMe123!\",\n  \"confirmPassword\": \"ChangeMe123!\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 501 theo triển khai hiện tại', function () { pm.response.to.have.status(501); });"] } }]
        }
      ]
    },
    {
      "name": "02 Admin users",
      "item": [
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/admin/users",
            "body": { "mode": "raw", "raw": "{\n  \"userName\": \"tenant_demo_001\",\n  \"email\": \"tenant_demo_001@example.com\",\n  \"password\": \"ChangeMe123!\",\n  \"role\": \"Tenant\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 201 và Approved', function () { pm.response.to.have.status(201); pm.expect(pm.response.json().data.approvalStatus).to.eql('Approved'); });", "if (pm.response.code === 201) { const d = pm.response.json().data; pm.environment.set('userId', d.id); pm.environment.set('userNameOrEmail', d.email); }"] } }]
        },
        {
          "name": "Pending landlords",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "url": "{{baseUrl}}/api/admin/users/pending-landlords"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200 và có danh sách', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().data).to.be.an('array'); });"] } }]
        },
        {
          "name": "Approve landlord",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "url": "{{baseUrl}}/api/admin/users/pending-landlords/{{pendingLandlordId}}/approve"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200 và Approved', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().data.approvalStatus).to.eql('Approved'); });"] } }]
        },
        {
          "name": "Reject landlord (dùng ID Pending khác)",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/admin/users/pending-landlords/{{pendingLandlordId}}/reject",
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Thong tin can duoc xac minh lai\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200 và Rejected', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().data.approvalStatus).to.eql('Rejected'); });"] } }]
        }
      ]
    },
    {
      "name": "03 Profile",
      "item": [
        {
          "name": "Get profile status",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "url": "{{baseUrl}}/api/users/{{userId}}/profile-status"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200 và có trạng thái hồ sơ', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().isProfileCompleted).to.be.a('boolean'); });"] } }]
        },
        {
          "name": "Update profile",
          "request": {
            "method": "PUT",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/users/{{userId}}/profile",
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Nguyen Van B\",\n  \"phoneNumber\": \"0912345679\",\n  \"citizenId\": \"012345678902\",\n  \"dateOfBirth\": \"1995-01-01\",\n  \"address\": \"Ho Chi Minh City\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200 và hồ sơ hoàn tất', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().data.isProfileCompleted).to.eql(true); });"] } }]
        }
      ]
    }
  ]
}
