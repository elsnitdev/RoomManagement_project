  AssignedToUserId nvarchar(450)
  Category nvarchar(20) [not null]
  ContractId uniqueidentifier [not null]
  Description nvarchar(2000) [not null]
  Priority nvarchar(10) [not null, default: 'Medium']
  RelatedInvoiceId uniqueidentifier
  RequestedAt datetime2(0) [not null, default: `SYSUTCDATETIME()`]
  RequestedByTenantId uniqueidentifier [not null]
  ResolutionNote nvarchar(1000)
  ResolvedAt datetime2(0)
  Status nvarchar(20) [not null, default: 'Pending']
  Title nvarchar(200) [not null]
  UpdatedAt datetime2(0)

  indexes {
    (AssignedToUserId, Status) [name: 'IX_TenantRequests_Assigned_Status', note: 'SQL filter: AssignedToUserId IS NOT NULL']
    (ContractId, Status) [name: 'IX_TenantRequests_Contract_Status']
    (RelatedInvoiceId, ContractId)
    (RequestedByTenantId, Status) [name: 'IX_TenantRequests_Tenant_Status']
  }

  checks {
    `(Category IN (N'Repair', N'Billing', N'Question', N'Complaint', N'Other', N'MoveOutNotice'))` [name: 'CK_TenantRequests_Category']
    `(Priority IN (N'Low', N'Medium', N'High'))` [name: 'CK_TenantRequests_Priority']
    `((Status = N'Resolved' AND ResolvedAt IS NOT NULL) OR (Status <> N'Resolved' AND ResolvedAt IS NULL))` [name: 'CK_TenantRequests_ResolvedAt']
    `(Status IN (N'Pending', N'InProgress', N'Resolved'))` [name: 'CK_TenantRequests_Status']
  }
}

Table dbo.UtilityRates {
  Id uniqueidentifier [pk, not null]
  CreatedAt datetime2(0) [not null, default: `SYSUTCDATETIME()`]
  EffectiveFrom date [not null]
  EffectiveTo date
  PropertyId uniqueidentifier [not null]
  Unit nvarchar(50) [not null]
  UnitPrice decimal(18,2) [not null]
  UtilityType nvarchar(20) [not null]

  indexes {
    (PropertyId, UtilityType) [unique, name: 'UX_UtilityRates_Open', note: 'SQL filter: EffectiveTo IS NULL']
    (PropertyId, UtilityType, EffectiveFrom) [unique, name: 'UX_UtilityRates_Start']
  }

  checks {
    `(EffectiveTo IS NULL OR EffectiveTo >= EffectiveFrom)` [name: 'CK_UtilityRates_Dates']
    `(UnitPrice >= 0)` [name: 'CK_UtilityRates_Price']
    `(UtilityType IN (N'Electricity', N'Water'))` [name: 'CK_UtilityRates_Type']
  }
}

